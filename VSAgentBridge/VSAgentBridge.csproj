<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>vsagentbridge</AssemblyName>
    <RootNamespace>VSAgentBridge</RootNamespace>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyTitle>VS Agent Bridge</AssemblyTitle>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Version>0.0.0-dev</Version>
    <Authors>AVErs</Authors>
    <Product>VS Agent Bridge</Product>
    <Description>Lets CLI coding agents (Claude Code, OpenCode) edit files in Visual Studio solutions: TFVC checkout, adding new files to projects, redirect to Output.</Description>
    <Copyright>©2026 AVErs</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="envdte" Version="8.0.2" ExcludeAssets="runtime" />
    <PackageReference Include="envdte80" Version="8.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VSAgentBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AGENTS.global.sample.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="AGENTS.sample.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="opencode\index.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="vsagentbridge.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Claude Code mod. Folders whose name starts with a dot are excluded from SDK default items,
         so the files in .claude-plugin are included explicitly. marketplace.json lists the mod itself
         ("source": "./"), so Claude Code installs it from this folder and loads it in place, next to the exe. -->
    <None Include="claude\.claude-plugin\plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="claude\.claude-plugin\marketplace.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="claude\hooks\hooks.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="claude\hooks\register.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="claude\.mcp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!--
    vsab-plugin-common.js is shared by the harness adapters and is imported from each adapter's own folder
    (a Claude Code mod cannot import files outside its plugin folder), so the build copies the one source file
    into every adapter folder of the output. Add a line here for each new adapter.
  -->
  <Target Name="CopyPluginCommon" AfterTargets="Build">
    <Copy SourceFiles="vsab-plugin-common.js" DestinationFolder="$(OutDir)opencode" SkipUnchangedFiles="true" />
    <Copy SourceFiles="vsab-plugin-common.js" DestinationFolder="$(OutDir)claude\hooks" SkipUnchangedFiles="true" />
  </Target>
  <!--
    Release package: after a Release build, copies the files users need into bin\Release\package\, laid out as the
    install folder, signs the copy of vsagentbridge.exe there (Build\Scripts\SignBinaries.ps1), and zips the folder as
    bin\Release\VSAgentBridge-<Version>.zip with a .sha256 file next to it. Files are listed explicitly, so build
    leftovers (vsagentbridge.json, .pdb, files Claude Code writes into the mod folder) never reach the package; a listed
    file that is missing, a missing signing key or a failed signature fails the build. Dependency DLLs are taken by
    mask: every DLL in the output is a dependency, and a missing one would stop the exe from starting.
  -->
  <Target Name="Package" AfterTargets="Build" DependsOnTargets="CopyPluginCommon" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageName>VSAgentBridge-$(Version).zip</PackageName>
      <PackageDir>$(MSBuildProjectDirectory)\$(BaseOutputPath)$(Configuration)\package\</PackageDir>
      <PackageZip>$(MSBuildProjectDirectory)\$(BaseOutputPath)$(Configuration)\$(PackageName)</PackageZip>
    </PropertyGroup>
    <ItemGroup>
      <PackageRoot Include="$(OutDir)vsagentbridge.exe;$(OutDir)vsagentbridge.exe.config;$(OutDir)vsagentbridge.sample.json;$(OutDir)AGENTS.global.sample.md;$(OutDir)AGENTS.sample.md;THIRD-PARTY-NOTICES.txt;..\README.md;..\CHANGELOG.md;..\LICENSE" />
      <PackageRoot Include="$(OutDir)*.dll" />
      <PackageClaude Include="$(OutDir)claude\.mcp.json" />
      <PackageClaudeManifest Include="$(OutDir)claude\.claude-plugin\plugin.json;$(OutDir)claude\.claude-plugin\marketplace.json" />
      <PackageClaudeHooks Include="$(OutDir)claude\hooks\hooks.json;$(OutDir)claude\hooks\register.js;$(OutDir)claude\hooks\vsab-plugin-common.js" />
      <PackageOpenCode Include="$(OutDir)opencode\index.js;$(OutDir)opencode\vsab-plugin-common.js" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="@(PackageRoot)" DestinationFolder="$(PackageDir)" />
    <Copy SourceFiles="@(PackageClaude)" DestinationFolder="$(PackageDir)claude" />
    <Copy SourceFiles="@(PackageClaudeManifest)" DestinationFolder="$(PackageDir)claude\.claude-plugin" />
    <Copy SourceFiles="@(PackageClaudeHooks)" DestinationFolder="$(PackageDir)claude\hooks" />
    <Copy SourceFiles="@(PackageOpenCode)" DestinationFolder="$(PackageDir)opencode" />
    <!-- Claude Code needs the Output folder to exist before a session starts; an empty folder may not survive a zip. -->
    <MakeDir Directories="$(PackageDir)Output" />
    <Touch Files="$(PackageDir)Output\.keep" AlwaysCreate="true" />
    <!-- Only the packaged copy is signed; the build output keeps the exe as the compiler produced it. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\Scripts\SignBinaries.ps1&quot; -TargetPath &quot;$(PackageDir)vsagentbridge.exe&quot;" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <GetFileHash Files="$(PackageZip)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="PackageHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(PackageZip).sha256" Lines="$(PackageHash)  $(PackageName)" Overwrite="true" />
    <Message Importance="high" Text="Package: $(PackageZip)" />
  </Target>
  <!--
    EnvDTE/stdole interop types are embedded into the exe (NoPIA).
    The license of these packages does not allow redistributing the DLLs,
    and embedding also removes any dependency on the installed VS version.
  -->
  <Target Name="EmbedVsInteropTypes" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'EnvDTE' or '%(FileName)' == 'EnvDTE80' or '%(FileName)' == 'stdole'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>